#!/usr/bin/env bash
# Settings of the deploy scripts themselves (startup.sh, shutdown.sh, deploy.sh).
# The application's own settings (database, ports, public address, ...) are NOT here: put the
# app's .env file next to these scripts (script/.env, same keys as .env.example) and the scripts
# hand it to the backend and the frontend.
#
# This file is tracked by git, and deploy.sh runs `git pull`. To change a value on a server,
# do not edit this file: create script/app.local.env (ignored by git) with only the lines you
# want to change. It is read right after this file.
#
# $SCRIPT_DIR is the folder these scripts are in.

### ===== 기본 정보 =====
APP_NAME="flowbit"

### ===== 실행 계정 제어 =====
ALLOW_ROOT_EXECUTION=true
# 비워 두면 누구나. 값을 넣으면 그 계정만 실행할 수 있다.
CONTROL_USER=""

### ===== 경로 =====
# git 저장소 (git pull 과 빌드를 하는 곳). 기본: 이 폴더의 상위 = 저장소 루트
SOURCE_DIR="$SCRIPT_DIR/.."
# 앱의 .env 파일. 없으면 application.yml 의 기본값으로 뜬다.
ENV_FILE="$SCRIPT_DIR/.env"
# 빌드 결과를 복사해 두고 실행하는 곳 (backend/app.jar, frontend/server.js)
RUN_DIR="$SCRIPT_DIR/app"
LOG_DIR="$SCRIPT_DIR/logs"

### ===== JVM / APP =====
# 쓸 JDK 의 설치 폴더 (그 아래에 bin/java 가 있는 곳). 예: /usr/lib/jvm/java-25-amazon-corretto
# 비워 두면 PATH 의 java 를 쓴다. 값을 넣으면 빌드(Gradle)와 백엔드 실행 둘 다 이 JDK 로 한다.
# 이 프로젝트는 JDK 25 가 필요하다.
JDK_HOME=""
JAVA_OPTS="-Xms512m -Xmx1024m -Djava.net.preferIPv4Stack=true"
# java -jar app.jar 뒤에 붙는 인자
APP_ARGS=""

### ===== 포트 =====
# 포트는 여기가 아니라 .env 에서 정한다: SERVER_PORT(백엔드, 기본 8080), FLOWBIT_WEB_PORT(프런트, 기본 3000)
# 프런트(Next.js 서버)가 듣는 주소. nginx 뒤에만 둘 거면 127.0.0.1
FRONT_HOST="0.0.0.0"

### ===== 종료 옵션 =====
SHUTDOWN_WAIT_SECONDS=30
FORCE_KILL_ENABLED=true

### ===== 헬스체크 옵션 =====
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH="/api/v1/health"
# 초 단위가 아니라 시도 횟수다 (HEALTH_CHECK_INTERVAL 초 간격)
HEALTH_CHECK_TIMEOUT=90
HEALTH_CHECK_INTERVAL=1

### ===== 로깅 =====
# 시작하는 동안 서버 로그를 화면에 함께 보여 준다
ECHO_START_LOG=true

### ===== 배포 잠금 =====
DEPLOY_LOCK_FILE="/tmp/flowbit.deploy.lock"
