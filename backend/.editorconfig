root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 160
ktlint_code_style = ktlint_official
# Test names are Korean sentences in backticks (docs/03-backend-guide.md)
ktlint_standard_function-naming = disabled
