# 복사해서 .env 로 만든 뒤 값을 바꾼다. .env 는 git 에 올리지 않는다.
# 아래 값은 로컬 개발용 기본값이다. 운영에서는 반드시 다른 비밀번호를 쓴다.

# PostgreSQL (docker-compose.yml)
FLOWBIT_DB_NAME=flowbit
FLOWBIT_DB_USER=flowbit
FLOWBIT_DB_PASSWORD=flowbit
FLOWBIT_DB_PORT=5432

# backend (DB 이름·계정·포트는 위 값을 함께 쓴다)
FLOWBIT_DB_HOST=localhost
SERVER_PORT=8080

# 업로드한 이미지를 저장할 폴더. 상대 경로는 백엔드를 실행한 폴더 기준이다.
# 운영에서는 백업되는 절대 경로를 지정한다. 예: /var/lib/flowbit/uploads
FLOWBIT_STORAGE_PATH=./data/uploads
# 올릴 수 있는 이미지 한 장의 최대 크기
FLOWBIT_MAX_UPLOAD_SIZE=5MB

# frontend
BACKEND_URL=http://localhost:8080
