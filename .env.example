# 복사해서 .env 로 만든 뒤 값을 바꾼다. .env 는 git 에 올리지 않는다.
# 아래 값은 로컬 개발용 기본값이다. 운영에서는 반드시 다른 비밀번호를 쓴다.
# 서버 배포(script/deploy.sh)는 이 파일이 아니라 서버의 script/.env 를 쓴다(처음 실행할 때 만들어진다).

# PostgreSQL (docker-compose.yml)
FLOWBIT_DB_NAME=flowbit
FLOWBIT_DB_USER=flowbit
FLOWBIT_DB_PASSWORD=flowbit
FLOWBIT_DB_PORT=5432

# backend (DB 이름·계정·포트는 위 값을 함께 쓴다)
FLOWBIT_DB_HOST=localhost
SERVER_PORT=8080

# 업로드한 이미지를 저장할 폴더. 상대 경로는 백엔드를 실행한 폴더 기준이다.
# 운영에서는 백업되는 절대 경로를 지정한다. 예: /var/lib/flowbit/uploads
# Windows 경로는 슬래시(/)로 쓴다. 예: C:/flowbit/uploads
# (이 파일에서 역슬래시는 이스케이프 문자다. C:\flowbit\uploads 라고 쓰면 역슬래시가 사라져 엉뚱한 폴더가 된다.)
FLOWBIT_STORAGE_PATH=./data/uploads
# 올릴 수 있는 파일의 최대 크기
FLOWBIT_MAX_UPLOAD_SIZE=10MB

# 올린 파일(이미지, 첨부 파일, 댓글 파일)을 Amazon S3 에 두려면 버킷 이름을 적는다. 적으면 모든 파일이 S3 에 올라가고,
# 비워 두면 위의 폴더에 둔다(기본). S3 로 바꾸기 전에 폴더에 있던 파일은 옮겨지지 않는다.
# FLOWBIT_S3_BUCKET=
# FLOWBIT_S3_REGION=ap-northeast-2
# 키를 적지 않으면 서버에 붙은 IAM 역할이나 AWS_ACCESS_KEY_ID 같은 환경 변수를 쓴다.
# FLOWBIT_S3_ACCESS_KEY=
# FLOWBIT_S3_SECRET_KEY=
# 버킷 안의 폴더(선택). 비우면 버킷 맨 위
# FLOWBIT_S3_PREFIX=flowbit
# MinIO 같은 S3 호환 저장소를 쓸 때만 그 주소를 적는다(AWS 는 적지 않는다).
# FLOWBIT_S3_ENDPOINT=
# 강제로 폴더에 두려면 local (버킷을 적어 둔 채로도)
# FLOWBIT_STORAGE_TYPE=local

# 사람들이 Flowbit 을 여는 주소. 메일과 API 알림에 넣는 티켓 링크에 쓴다(없으면 /issue/FB-12 같은
# 경로만 들어간다). SSO 의 리다이렉트 URI 에도 쓰는데, 그쪽은 비워 두면 요청에서 알아낸다.
# FLOWBIT_PUBLIC_URL=https://flowbit.example.com

# docker compose --profile app 으로 띄울 때 프런트를 여는 호스트 포트
# FLOWBIT_WEB_PORT=3000
# 그 포트를 여는 주소. 앞에 nginx 를 두고 이 서버 안에서만 열려면 127.0.0.1
# FLOWBIT_WEB_BIND=0.0.0.0

# frontend (프런트엔드는 이 파일을 읽지 않는다. 환경 변수나 frontend/.env.local 로 준다)
BACKEND_URL=http://localhost:8080
# 개발 서버(npm run dev)는 이 PC 의 127.0.0.1, 사내망 IP, 컴퓨터 이름으로 열어도 동작한다(적을 필요 없다).
# 다른 PC 의 이름·주소로 열 때만 그 호스트를 쉼표로 적는다. 없으면 그 주소에서는 화면의 스크립트가 막혀
# 로그인·메뉴 등이 동작하지 않는다. 예: 192.168.0.80 또는 192.168.0.*
# FLOWBIT_DEV_ORIGINS=192.168.0.80
