# 복사해서 .env 로 만든 뒤 값을 바꾼다. .env 는 git 에 올리지 않는다.
# 아래 값은 로컬 개발용 기본값이다. 운영에서는 반드시 다른 비밀번호를 쓴다.

# PostgreSQL (docker-compose.yml)
FLOWBIT_DB_NAME=flowbit
FLOWBIT_DB_USER=flowbit
FLOWBIT_DB_PASSWORD=flowbit
FLOWBIT_DB_PORT=5432

# backend
FLOWBIT_DB_URL=jdbc:postgresql://localhost:5432/flowbit
FLOWBIT_BASE_URL=http://localhost:3000

# frontend
BACKEND_URL=http://localhost:8080
