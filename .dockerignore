# The image is built from the repository root (Dockerfile). Only backend/, frontend/ and
# docker/entrypoint.sh are needed; everything installed or built is made again inside the image.
.git
.idea
.claude
agent-skills
docs
data
script
*.md

backend/.gradle
backend/build
backend/build-*
backend/data
backend/.idea
backend/*.iml

frontend/node_modules
frontend/.next
frontend/out
frontend/tsconfig.tsbuildinfo
frontend/npm-debug.log*
# Playwright output (traces and screenshots can hold login cookies) and the e2e specs: not part of the image
frontend/test-results
frontend/playwright-report
frontend/e2e

**/.env
**/.env.*
